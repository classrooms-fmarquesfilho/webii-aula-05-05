{
  "name": "Web II — Aula 07/05",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo pg_ctlcluster 15 main start 2>/dev/null || true",
  "containerEnv": {
    "DATABASE_URL": "postgres://postgres@/aula?host=/var/run/postgresql&sslmode=disable",
    "PGPASSWORD": "postgres"
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"],
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" }
    }
  }
}